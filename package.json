{
  "name": "cookie-clicker",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "deploy": "bun run --sequential build wrangler:deploy",
    "dev": "vite dev",
    "format": "biome check --write",
    "knip": "knip && knip --production",
    "lint": "biome check",
    "prepare": "svelte-kit sync",
    "preview": "vite preview",
    "test": "bun test",
    "wrangler:deploy": "wrangler deploy"
  },
  "overrides": {
    "@oxc-project/types": "0.148.0",
    "lightningcss": "1.33.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@gameroman/config": "0.2.9",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "knip": "6.34.0",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "wrangler": "4.128.0"
  }
}
